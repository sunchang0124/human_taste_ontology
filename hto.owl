        <rdfs:label>questionnaire</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000001">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A dependent entity that inheres in a bearer by virtue of how the bearer is related to other entities</obo:IAO_0000115>
        <rdfs:label>quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0000049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000049">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A quality inhering in a bearer by virtue of the bearer&apos;s possessing or displaying a distinctive feature in type or degree or effect or force.</obo:IAO_0000115>
        <rdfs:label>intensity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001241 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001241">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>Relational qualities are qualities that hold between multiple entities. Normal (monadic) qualities such as the shape of a eyeball exist purely as a quality of that eyeball. A relational quality such as sensitivity to light is a quality of that eyeball (and connecting nervous system) as it relates to incoming light waves/particles.</obo:IAO_0000115>
        <rdfs:label>physical object quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001309 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001309">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A process quality inhering in a bearer by virtue of the bearer&apos;s magnitude of the temporal extent between the starting and ending point.</obo:IAO_0000115>
        <rdfs:label>duration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002325 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002325">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The temporal relation between the start of the process with respect to a reference process.</obo:IAO_0000115>
        <rdfs:label>onset quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002474 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002474">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A flavor quality inhering in a bearer by virtue of the bearer&apos;s having an acrid, sharp, or disagreeable flavor.</obo:IAO_0000115>
        <rdfs:label>bitter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0000167 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000167">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>Anatomical cavity at the start of the digestive tract that that is enclosed by the mouth. The boundaries and contents vary depending on the species. In vertebrates, the boundaries are the oral opening, the cheeks, the palate and (if present) the palatoglossal arch - if this is not present then the mouth and pharynx form the oropharyngeal cavity. The buccal cavity contains the teeth, tongue and palate (when present).</obo:IAO_0000115>
        <rdfs:label>oral cavity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001723 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001723">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A muscular organ in the floor of the mouth.</obo:IAO_0000115>
        <rdfs:label>tongue</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001727 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001727">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A specialized receptor organ that is a collection of cells spanning the gustatory epithelium.</obo:IAO_0000115>
        <rdfs:label>taste bud</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0002448 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002448">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>Any of the mushroom-shaped papillae, which have a single taste bud at the tip, located mostly on the dorsal anterior portion of the tongue.</obo:IAO_0000115>
        <rdfs:label>fungiform papilla</rdfs:label>
    </owl:Class>
</rdf:RDF>



