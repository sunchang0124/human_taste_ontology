<?xml version="1.0"?>
<rdf:RDF xmlns="http://purl.obolibrary.org/obo/hto.owl#"
     xml:base="http://purl.obolibrary.org/obo/hto.owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/hto.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/hto/2026-09-17/hto.owl"/>
        <dc:description>An ontology of human taste perception: the qualities people perceive when they taste, and the tasting events in which they report them.</dc:description>
        <dc:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dc:title>Human Taste Ontology</dc:title>
        <dcterms:creator>Chang Sun</dcterms:creator>
        <rdfs:comment>Developed at BioHackathon 2026, Matsuyama, Japan. The HTO prefix is not yet registered with the OBO Foundry, so HTO PURLs do not resolve.</rdfs:comment>
    </owl:Ontology>
    


