    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/CHEBI_15854 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_15854">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A cinchona alkaloid that is cinchonidine in which the hydrogen at the 6-position of the quinoline ring is substituted by methoxy.</obo:IAO_0000115>
        <rdfs:label>quinine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_16015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_16015">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>An optically active form of glutamic acid having &lt;small&gt;L&lt;/small&gt;-configuration.</obo:IAO_0000115>
        <rdfs:label>L-glutamic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_16226 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_16226">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>limonin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_17992 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_17992">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A glycosyl glycoside formed by glucose and fructose units joined by an acetal oxygen bridge from hemiacetal of glucose to the hemiketal of the fructose.</obo:IAO_0000115>
        <rdfs:label>sucrose</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26710 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26710">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>An inorganic chloride salt having sodium(1+) as the counterion.</obo:IAO_0000115>
        <rdfs:label>sodium chloride</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27732 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27732">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A trimethylxanthine in which the three methyl groups are located at positions 1, 3, and 7. A purine alkaloid that occurs naturally in tea and coffee.</obo:IAO_0000115>
        <rdfs:label>caffeine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28775 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28775">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A disaccharide derivative that consists of hesperetin substituted by a 6-&lt;em&gt;O&lt;/em&gt;-(α-&lt;small&gt;L&lt;/small&gt;-rhamnopyranosyl)-β-&lt;small&gt;D&lt;/small&gt;-glucopyranosyl moiety at position 7 via a glycosidic linkage.</obo:IAO_0000115>
        <rdfs:label>hesperidin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28819 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28819">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A disaccharide derivative that is (&lt;i&gt;S&lt;/i&gt;)-naringenin substituted by a 2-&lt;em&gt;O&lt;/em&gt;-(α-&lt;small&gt;L&lt;/small&gt;-rhamnopyranosyl)-β-&lt;small&gt;D&lt;/small&gt;-glucopyranosyl moiety at position 7 via a glycosidic linkage.</obo:IAO_0000115>
        <rdfs:label>naringin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_30769 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_30769">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A tricarboxylic acid that is propane-1,2,3-tricarboxylic acid bearing a hydroxy substituent at position 2. It is an important metabolite in the pathway of all aerobic organisms.</obo:IAO_0000115>
        <rdfs:label>citric acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_46261 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_46261">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A member of the class of thioureas that is thiourea in which one of the hydrogens is replaced by a phenyl group. Depending on their genetic makeup, humans find it either very bitter-tasting or tasteless. This unusual property resulted in &lt;em&gt;N&lt;/em&gt;-phenylthiourea being used in paternity testing prior to the advent of DNA testing.</obo:IAO_0000115>
        <rdfs:label>N-phenylthiourea</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_8502 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_8502">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A pyrimidinethione consisting of uracil in which the 2-oxo group is substituted by a thio group and the hydrogen at position 6 is substituted by a propyl group.</obo:IAO_0000115>
        <rdfs:label>6-propyl-2-thiouracil</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000209">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A specialized cell involved in gustatory sensory perception.</obo:IAO_0000115>
        <rdfs:label>taste receptor cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003027">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A whole fruit of a pomelo tree (Citrus maximus)</obo:IAO_0000115>
        <rdfs:label>pomelo fruit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003324 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003324">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A hesperidium fruit of a citrus plant (Citrus).</obo:IAO_0000115>
        <rdfs:label>citrus fruit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003554 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003554">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A hesperidium fruit of a grapefruit tree (Citrus x paradisi).</obo:IAO_0000115>
        <rdfs:label>grapefruit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003555 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003555">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A hesperidium fruit of a mandarin orange tree (Citrus reticulata).</obo:IAO_0000115>
        <rdfs:label>mandarin orange</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003732 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003732">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A hesperidium fruit of a yuzu plant (Citrus junos)</obo:IAO_0000115>
        <rdfs:label>yuzu</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03301103 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03301103">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>SIREN DB annotation: * liquid, low viscosity, with small particles FOODON:03430114 * fruit, peel removed, core, pit or seed removed FOODON:03420229</obo:IAO_0000115>
        <rdfs:label>orange juice</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03305428 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03305428">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>SIREN DB annotation: * liquid, low viscosity FOODON:03430109 * fruit, peel present, core, pit or seed present FOODON:03420140</obo:IAO_0000115>
        <rdfs:label>lemon juice</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03305742 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03305742">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>SIREN DB annotation: * liquid, low viscosity FOODON:03430109 * fruit, peel present, core, pit or seed present FOODON:03420140</obo:IAO_0000115>
        <rdfs:label>citrus juice</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0001580 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0001580">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The series of events required for a bitter taste stimulus to be received and converted to a molecular signal.</obo:IAO_0000115>
        <rdfs:label>detection of chemical stimulus involved in sensory perception of bitter taste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0008150 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0008150">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>Note that, in addition to forming the root of the biological process ontology, this term is recommended for the annotation of gene products whose biological process is unknown. When this term is used for annotation, it indicates that no information was available about the biological process of the gene product annotated as of the date the annotation was made; the evidence code &apos;no data&apos; (ND), is used to indicate this.</obo:IAO_0000115>
        <rdfs:label>biological_process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0008527 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0008527">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>Combining with soluble compounds to initiate a change in cell activity. These receptors are responsible for the sense of taste.</obo:IAO_0000115>
        <rdfs:label>taste receptor activity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0033038 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0033038">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>Combining with soluble bitter compounds to initiate a change in cell activity. These receptors are responsible for the sense of bitter taste.</obo:IAO_0000115>
        <rdfs:label>bitter taste receptor activity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0050909 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0050909">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The series of events required for an organism to receive a gustatory stimulus, convert it to a molecular signal, and recognize and characterize the signal. Gustation involves the direct detection of chemical composition, usually through contact with chemoreceptor cells. This is a neurological process.</obo:IAO_0000115>
        <rdfs:label>sensory perception of taste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0050913 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0050913">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The series of events required to receive a bitter taste stimulus, convert it to a molecular signal, and recognize and characterize the signal. This is a neurological process.</obo:IAO_0000115>
        <rdfs:label>sensory perception of bitter taste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0050914 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0050914">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The series of events required to receive a salty taste stimulus, convert it to a molecular signal, and recognize and characterize the signal. This is a neurological process.</obo:IAO_0000115>
        <rdfs:label>sensory perception of salty taste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0050915 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0050915">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The series of events required to receive a sour taste stimulus, convert it to a molecular signal, and recognize and characterize the signal. This is a neurological process.</obo:IAO_0000115>
        <rdfs:label>sensory perception of sour taste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0050916 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0050916">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The series of events required to receive a sweet taste stimulus, convert it to a molecular signal, and recognize and characterize the signal. This is a neurological process.</obo:IAO_0000115>
        <rdfs:label>sensory perception of sweet taste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0050917 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0050917">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The series of events required to receive an umami taste stimulus, convert it to a molecular signal, and recognize and characterize the signal. Umami taste is the savory taste of meats and other foods that are rich in glutamates. This is a neurological process.</obo:IAO_0000115>
        <rdfs:label>sensory perception of umami taste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0090682 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0090682">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A G protein-coupled receptor activity that is responsible for the sense of bitter taste.</obo:IAO_0000115>
        <rdfs:label>GPCR bitter taste receptor activity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000223 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000223">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Abnormality of taste sensation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000224 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000224">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A decreased ability to perceive flavor.</obo:IAO_0000115>
        <rdfs:label>Hypogeusia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031249 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031249">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A distortion of the sense of taste, often characterized by the sensation of a metallic taste.</obo:IAO_0000115>
        <rdfs:label>Parageusia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0041051 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0041051">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A rare condition that is characterized by a complete loss of taste function of the tongue.</obo:IAO_0000115>
        <rdfs:label>Ageusia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000070"/>
        <obo:IAO_0000115>A planned process in which a human taster orally samples a stimulus and reports one or more perceived taste qualities.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>tasting event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000002">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A role borne by a person in virtue of taking part in a tasting event as the person doing the tasting.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>taster role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000003">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A material entity presented to a taster to be tasted.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>taste stimulus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000003"/>
        <obo:IAO_0000115>A taste stimulus consisting of a single chemical compound presented at a stated concentration in order to calibrate or classify a taster.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>reference tastant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115>An information content entity recording that one taster perceived one perceptual taste quality in one stimulus on one occasion.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>taste percept assertion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000026"/>
        <obo:IAO_0000115>A scalar measurement datum recording how strong a perceived taste quality was, on a stated scale.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>intensity rating</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000026"/>
        <obo:IAO_0000115>A scalar measurement datum recording how much a taster liked or disliked a stimulus, on a stated scale.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>hedonic rating</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115>An information content entity specifying the permitted values and anchors used to record a rating.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>rating scale</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000032"/>
        <obo:IAO_0000115>A scalar measurement datum recording the lowest concentration of a tastant at which a taster reliably detects that something differs from the blank.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>detection threshold datum</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000032"/>
        <obo:IAO_0000115>A scalar measurement datum recording the lowest concentration of a tastant at which a taster reliably names the quality correctly.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>recognition threshold datum</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBA_VT0001986"/>
        <obo:IAO_0000115>An organism trait classifying a person by their sensitivity to a reference bitter tastant, conventionally propylthiouracil.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>taster status</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000011"/>
        <obo:IAO_0000115>A taster status in which the person reports no bitterness from a propylthiouracil test strip.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>PROP non-taster</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000011"/>
        <obo:IAO_0000115>A taster status in which the person reports moderate bitterness from a propylthiouracil test strip.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>PROP medium taster</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000011"/>
        <obo:IAO_0000115>A taster status in which the person reports intense bitterness from a propylthiouracil test strip.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>PROP super-taster</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115>An information content entity recording the pair of TAS2R38 haplotypes carried by a person, each haplotype being the combination of the amino acid states at positions 49, 262 and 296.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>TAS2R38 diplotype</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115>An information content entity recording an assertion about a person&apos;s genotype at a locus relevant to taste perception.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>taste genotype assertion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000070"/>
        <obo:IAO_0000115>A planned process comprising the tasting events performed by one or more tasters on one occasion under one protocol.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>tasting session</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000018">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A process performed between tasting events in order to reduce carry-over of taste from the previous stimulus.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>palate cleansing process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115>An information content entity stating what the taster was able to know about the identity of the stimulus at the time of tasting.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>blinding condition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000032"/>
        <obo:IAO_0000115>A scalar measurement datum recording perceived intensity as a function of time since the stimulus entered the mouth.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>time-intensity profile datum</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115>An information content entity recording a property of a taster that is known to alter taste perception and that should be accounted for when analysing their ratings.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>taste confounder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000021"/>
        <obo:IAO_0000115>A taste confounder recording that the taster currently uses tobacco.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>tobacco use confounder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000021"/>
        <obo:IAO_0000115>A taste confounder recording that the taster recently had an upper respiratory infection, including a recent loss of smell.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>recent upper respiratory infection confounder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000021"/>
        <obo:IAO_0000115>A taste confounder recording that the taster has reduced salivary flow.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>xerostomia confounder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000021"/>
        <obo:IAO_0000115>A taste confounder recording that the taster takes a medication with a documented taste-distortion side effect.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>dysgeusia-associated medication confounder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000032"/>
        <obo:IAO_0000115>A scalar measurement datum recording a value a taster reported on a stated scale, whether of a perceived quality&apos;s intensity or of liking.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>rating</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000100 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001241"/>
        <obo:IAO_0000115>A quality of a material entity that is realised when a human perceiver tastes that entity.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>perceptual taste quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000110 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000100"/>
        <obo:IAO_0000115>A perceptual taste quality for which a dedicated class of human taste receptor and a dedicated transduction pathway are established.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>basic taste quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000111 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000110"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/HTO_0000061"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0050916"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The basic taste quality typically elicited by sucrose and other sugars, transduced by the TAS1R2 and TAS1R3 receptor pair.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:comment>PATO has no term for this quality as of 2026-09-17; proposed to PATO.</rdfs:comment>
        <rdfs:label>sweetness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000112 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000110"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/HTO_0000061"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0050915"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The basic taste quality typically elicited by citric acid and other acids, transduced by proton-sensitive channels of taste receptor cells.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:comment>PATO has no term for this quality as of 2026-09-17; proposed to PATO.</rdfs:comment>
        <rdfs:label>sourness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000110"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/HTO_0000061"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0050914"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The basic taste quality typically elicited by sodium chloride. The epithelial sodium channel is implicated in its transduction, and is well supported in rodents, but a substantial part of human salt taste is amiloride-insensitive and the channel&apos;s role in humans remains contested.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:comment>PATO has no term for this quality as of 2026-09-17; proposed to PATO.</rdfs:comment>
        <rdfs:label>saltiness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000114 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000110"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/HTO_0000061"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0050913"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The basic taste quality typically elicited by quinine and by many plant alkaloids and glycosides, transduced by the TAS2R receptor family.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:comment>Mapped to PATO:0002474 by skos:exactMatch in mappings/hto-pato.sssom.tsv.</rdfs:comment>
        <rdfs:label>bitterness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000115 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000110"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/HTO_0000061"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0050917"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The basic taste quality typically elicited by L-glutamate and by certain ribonucleotides, transduced by the TAS1R1 and TAS1R3 receptor pair.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:comment>PATO has no term for this quality as of 2026-09-17; proposed to PATO.</rdfs:comment>
        <rdfs:label>umami</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000120 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000100"/>
        <obo:IAO_0000115>A perceptual taste quality that has been proposed as basic but for which receptor or transduction evidence remains contested.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:comment>Grouped separately so that including these terms does not commit a user of HTO to the claim that they are basic tastes.</rdfs:comment>
        <rdfs:label>candidate taste quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000121 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000120"/>
        <obo:IAO_0000115>The candidate taste quality elicited by non-esterified fatty acids, proposed under the name oleogustus and distinct from the texture of fat.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:26142421</obo:IAO_0000119>
        <rdfs:label>fattiness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000120"/>
        <obo:IAO_0000115>The candidate taste quality described as mouthfulness, continuity and thickness, elicited by certain gamma-glutamyl peptides acting on the calcium-sensing receptor.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:39890873</obo:IAO_0000119>
        <rdfs:label>kokumi</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000123 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000120"/>
        <obo:IAO_0000115>The candidate taste quality elicited by certain metal salts and reported as a side effect of some medications.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>metallic taste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000124 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000124">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000120"/>
        <obo:IAO_0000115>The candidate taste quality elicited by calcium salts, reported as chalky and somewhat bitter.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>calcium taste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000125 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000125">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000120"/>
        <obo:IAO_0000115>The candidate taste quality elicited by oligomeric glucose polymers independently of sweetness.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:27553043</obo:IAO_0000119>
        <rdfs:label>starchy taste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000130 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000130">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000114"/>
        <obo:IAO_0000115>A bitterness distinguished by the chemical class of the compound that elicits it and, where known, by the receptor that detects it.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>bitterness subtype</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000131 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000131">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000130"/>
        <obo:IAO_0000115>The bitterness elicited by compounds bearing a thiourea group, notably phenylthiocarbamide and propylthiouracil, detected by TAS2R38.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:12595690</obo:IAO_0000119>
        <rdfs:comment>The quality whose perception varies most sharply between people.</rdfs:comment>
        <rdfs:label>thiourea bitterness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000132 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000132">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000130"/>
        <obo:IAO_0000115>The bitterness elicited by limonoid triterpenoids, notably limonin, which forms from a tasteless precursor after citrus fruit is juiced.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:25615579</obo:IAO_0000119>
        <rdfs:label>limonoid bitterness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000133 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000133">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000130"/>
        <obo:IAO_0000115>The bitterness elicited by flavanone glycosides, notably naringin, characteristic of grapefruit and pomelo.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:9250119</obo:IAO_0000119>
        <rdfs:label>flavanone bitterness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000134 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000134">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000130"/>
        <obo:IAO_0000115>The bitterness elicited by plant alkaloids such as quinine and caffeine.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>alkaloid bitterness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000135 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000135">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000130"/>
        <obo:IAO_0000115>The bitterness elicited by hydrophobic amino acids and by peptides rich in them, prominent in protein hydrolysates and aged cheese.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>amino acid bitterness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000140 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000100"/>
        <obo:IAO_0000115>A quality perceived in the mouth through the trigeminal nerve rather than through taste receptor cells, recorded alongside taste by sensory panels.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:comment>Not a taste sensu stricto. Included because panels record it and because astringency is central to citrus assessment.</rdfs:comment>
        <rdfs:label>chemesthetic quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000141 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000140"/>
        <obo:IAO_0000115>The chemesthetic quality of drying, roughening and puckering in the mouth, elicited by tannins and other polyphenols binding salivary proteins.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:27640622</obo:IAO_0000119>
        <rdfs:comment>CHEBI:74783 astringent exists but denotes a chemical role, not a perceptual quality.</rdfs:comment>
        <rdfs:label>astringency</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000142 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000140"/>
        <obo:IAO_0000115>The chemesthetic quality of burning or stinging, elicited by capsaicinoids, piperine and allyl isothiocyanate.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>pungency</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000143 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000140"/>
        <obo:IAO_0000115>The chemesthetic quality of coolness in the absence of a temperature change, elicited by menthol and related compounds.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>cooling sensation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000144 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000144">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000140"/>
        <obo:IAO_0000115>The chemesthetic quality of vibration or numbness, elicited by alkylamides such as sanshool.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>tingling sensation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000145 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000140"/>
        <obo:IAO_0000115>The chemesthetic quality elicited by dissolved carbon dioxide, arising from two distinct routes: conversion of carbon dioxide by carbonic anhydrase 4 on sour-sensing taste cells, and a separate trigeminal contribution.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>carbonation bite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000150 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000150">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000100"/>
        <obo:IAO_0000115>A perceptual taste quality defined by when it appears or how long it persists relative to the stimulus entering the mouth.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>temporal taste quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000151 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000151">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000150"/>
        <obo:IAO_0000115>The temporal taste quality of how long after the stimulus enters the mouth a taste is first perceived.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>taste onset latency</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000152 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000150"/>
        <obo:IAO_0000115>The temporal taste quality of a taste that persists after the stimulus has been swallowed or expectorated.</obo:IAO_0000115>
        <obo:IAO_0000119>SNOMEDCT:110365009</obo:IAO_0000119>
        <rdfs:label>aftertaste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000153 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000153">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000152"/>
        <obo:IAO_0000115>An aftertaste that is bitter in quality.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>lingering bitterness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000154 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000154">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000152"/>
        <obo:IAO_0000115>A bitterness that is absent or weak when the stimulus is first tasted and appears or strengthens over subsequent minutes to hours.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:25615579</obo:IAO_0000119>
        <rdfs:comment>Characteristic of citrus juice, where limonin forms after juicing.</rdfs:comment>
        <rdfs:label>delayed bitterness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000155 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000155">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000150"/>
        <obo:IAO_0000115>The temporal taste quality of a perceived intensity declining during continued exposure to an unchanging stimulus.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>taste adaptation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000160 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000100"/>
        <obo:IAO_0000115>A quality of a stimulus consisting in how much a perceiver likes or dislikes tasting it, as distinct from what they perceive.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>hedonic taste quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000161 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000161">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000160"/>
        <obo:IAO_0000115>The hedonic taste quality of being pleasant to taste for a given perceiver.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>palatability</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000162 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000160"/>
        <obo:IAO_0000115>The hedonic taste quality of being unpleasant to taste for a given perceiver, whether innately or through learning.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>taste aversion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000300 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000300">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000008"/>
        <obo:IAO_0000115>A rating scale running from zero to one hundred with quasi-logarithmically spaced verbal anchors from barely detectable to strongest imaginable sensation of any kind, permitting comparison of intensities across people.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>general Labelled Magnitude Scale</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000301 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000301">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000008"/>
        <obo:IAO_0000115>A rating scale running from zero to one hundred with verbal anchors referring to the strongest imaginable taste sensation rather than to any sensation.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>Labelled Magnitude Scale</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000302 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000302">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000008"/>
        <obo:IAO_0000115>A rating scale with nine categories running from dislike extremely to like extremely, used to record liking.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>nine-point hedonic scale</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000303 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000303">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HTO_0000008"/>
        <obo:IAO_0000115>A rating scale on which the taster marks a point on an unstructured line of stated length, conventionally one hundred millimetres.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>visual analogue scale</rdfs:label>
    </owl:Class>
    


