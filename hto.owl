    <!-- http://purl.obolibrary.org/obo/CHEBI_15854 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_15854">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A cinchona alkaloid that is cinchonidine in which the hydrogen at the 6-position of the quinoline ring is substituted by methoxy.</obo:IAO_0000115>
        <rdfs:label>quinine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_16015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_16015">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>An optically active form of glutamic acid having &lt;small&gt;L&lt;/small&gt;-configuration.</obo:IAO_0000115>
        <rdfs:label>L-glutamic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_16226 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_16226">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>limonin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_17992 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_17992">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A glycosyl glycoside formed by glucose and fructose units joined by an acetal oxygen bridge from hemiacetal of glucose to the hemiketal of the fructose.</obo:IAO_0000115>
        <rdfs:label>sucrose</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26710 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26710">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>An inorganic chloride salt having sodium(1+) as the counterion.</obo:IAO_0000115>
        <rdfs:label>sodium chloride</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27732 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27732">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A trimethylxanthine in which the three methyl groups are located at positions 1, 3, and 7. A purine alkaloid that occurs naturally in tea and coffee.</obo:IAO_0000115>
        <rdfs:label>caffeine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28775 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28775">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A disaccharide derivative that consists of hesperetin substituted by a 6-&lt;em&gt;O&lt;/em&gt;-(α-&lt;small&gt;L&lt;/small&gt;-rhamnopyranosyl)-β-&lt;small&gt;D&lt;/small&gt;-glucopyranosyl moiety at position 7 via a glycosidic linkage.</obo:IAO_0000115>
        <rdfs:label>hesperidin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28819 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28819">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A disaccharide derivative that is (&lt;i&gt;S&lt;/i&gt;)-naringenin substituted by a 2-&lt;em&gt;O&lt;/em&gt;-(α-&lt;small&gt;L&lt;/small&gt;-rhamnopyranosyl)-β-&lt;small&gt;D&lt;/small&gt;-glucopyranosyl moiety at position 7 via a glycosidic linkage.</obo:IAO_0000115>
        <rdfs:label>naringin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_30769 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_30769">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A tricarboxylic acid that is propane-1,2,3-tricarboxylic acid bearing a hydroxy substituent at position 2. It is an important metabolite in the pathway of all aerobic organisms.</obo:IAO_0000115>
        <rdfs:label>citric acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_46261 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_46261">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A member of the class of thioureas that is thiourea in which one of the hydrogens is replaced by a phenyl group. Depending on their genetic makeup, humans find it either very bitter-tasting or tasteless. This unusual property resulted in &lt;em&gt;N&lt;/em&gt;-phenylthiourea being used in paternity testing prior to the advent of DNA testing.</obo:IAO_0000115>
        <rdfs:label>N-phenylthiourea</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_8502 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_8502">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A pyrimidinethione consisting of uracil in which the 2-oxo group is substituted by a thio group and the hydrogen at position 6 is substituted by a propyl group.</obo:IAO_0000115>
        <rdfs:label>6-propyl-2-thiouracil</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000209">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A specialized cell involved in gustatory sensory perception.</obo:IAO_0000115>
        <rdfs:label>taste receptor cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003027">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A whole fruit of a pomelo tree (Citrus maximus)</obo:IAO_0000115>
        <rdfs:label>pomelo fruit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003324 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003324">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A hesperidium fruit of a citrus plant (Citrus).</obo:IAO_0000115>
        <rdfs:label>citrus fruit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003554 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003554">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A hesperidium fruit of a grapefruit tree (Citrus x paradisi).</obo:IAO_0000115>
        <rdfs:label>grapefruit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003555 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003555">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A hesperidium fruit of a mandarin orange tree (Citrus reticulata).</obo:IAO_0000115>
        <rdfs:label>mandarin orange</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003732 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003732">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A hesperidium fruit of a yuzu plant (Citrus junos)</obo:IAO_0000115>
        <rdfs:label>yuzu</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03301103 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03301103">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>SIREN DB annotation: * liquid, low viscosity, with small particles FOODON:03430114 * fruit, peel removed, core, pit or seed removed FOODON:03420229</obo:IAO_0000115>
        <rdfs:label>orange juice</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03305428 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03305428">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>SIREN DB annotation: * liquid, low viscosity FOODON:03430109 * fruit, peel present, core, pit or seed present FOODON:03420140</obo:IAO_0000115>
        <rdfs:label>lemon juice</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03305742 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03305742">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>SIREN DB annotation: * liquid, low viscosity FOODON:03430109 * fruit, peel present, core, pit or seed present FOODON:03420140</obo:IAO_0000115>
        <rdfs:label>citrus juice</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0001580 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0001580">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The series of events required for a bitter taste stimulus to be received and converted to a molecular signal.</obo:IAO_0000115>
        <rdfs:label>detection of chemical stimulus involved in sensory perception of bitter taste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0008150 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0008150">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>Note that, in addition to forming the root of the biological process ontology, this term is recommended for the annotation of gene products whose biological process is unknown. When this term is used for annotation, it indicates that no information was available about the biological process of the gene product annotated as of the date the annotation was made; the evidence code &apos;no data&apos; (ND), is used to indicate this.</obo:IAO_0000115>
        <rdfs:label>biological_process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0008527 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0008527">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>Combining with soluble compounds to initiate a change in cell activity. These receptors are responsible for the sense of taste.</obo:IAO_0000115>
        <rdfs:label>taste receptor activity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0033038 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0033038">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>Combining with soluble bitter compounds to initiate a change in cell activity. These receptors are responsible for the sense of bitter taste.</obo:IAO_0000115>
        <rdfs:label>bitter taste receptor activity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0050909 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0050909">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The series of events required for an organism to receive a gustatory stimulus, convert it to a molecular signal, and recognize and characterize the signal. Gustation involves the direct detection of chemical composition, usually through contact with chemoreceptor cells. This is a neurological process.</obo:IAO_0000115>
        <rdfs:label>sensory perception of taste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0050913 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0050913">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The series of events required to receive a bitter taste stimulus, convert it to a molecular signal, and recognize and characterize the signal. This is a neurological process.</obo:IAO_0000115>
        <rdfs:label>sensory perception of bitter taste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0050914 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0050914">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The series of events required to receive a salty taste stimulus, convert it to a molecular signal, and recognize and characterize the signal. This is a neurological process.</obo:IAO_0000115>
        <rdfs:label>sensory perception of salty taste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0050915 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0050915">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The series of events required to receive a sour taste stimulus, convert it to a molecular signal, and recognize and characterize the signal. This is a neurological process.</obo:IAO_0000115>
        <rdfs:label>sensory perception of sour taste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0050916 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0050916">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The series of events required to receive a sweet taste stimulus, convert it to a molecular signal, and recognize and characterize the signal. This is a neurological process.</obo:IAO_0000115>
        <rdfs:label>sensory perception of sweet taste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0050917 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0050917">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The series of events required to receive an umami taste stimulus, convert it to a molecular signal, and recognize and characterize the signal. Umami taste is the savory taste of meats and other foods that are rich in glutamates. This is a neurological process.</obo:IAO_0000115>
        <rdfs:label>sensory perception of umami taste</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0090682 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0090682">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A G protein-coupled receptor activity that is responsible for the sense of bitter taste.</obo:IAO_0000115>
        <rdfs:label>GPCR bitter taste receptor activity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000223 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000223">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Abnormality of taste sensation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000224 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000224">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A decreased ability to perceive flavor.</obo:IAO_0000115>
        <rdfs:label>Hypogeusia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031249 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031249">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A distortion of the sense of taste, often characterized by the sensation of a metallic taste.</obo:IAO_0000115>
        <rdfs:label>Parageusia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0041051 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0041051">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A rare condition that is characterized by a complete loss of taste function of the tongue.</obo:IAO_0000115>
        <rdfs:label>Ageusia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HTO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000070"/>
        <obo:IAO_0000115>A planned process in which a human taster orally samples a stimulus and reports one or more perceived taste qualities.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>tasting event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000030">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A generically dependent continuant that is about some thing.</obo:IAO_0000115>
        <rdfs:label>information content entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000032">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A scalar measurement datum is a measurement datum that is composed of two parts, numerals and a unit label.</obo:IAO_0000115>
        <rdfs:label>scalar measurement datum</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000109 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000109">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A measurement datum is an information content entity that is a recording of the output of a measurement such as produced by a device.</obo:IAO_0000115>
        <rdfs:label>measurement datum</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBA_VT0001986 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBA_VT0001986">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The sensitivity toward of a sensory perception of taste.</obo:IAO_0000115>
        <rdfs:label>taste sensitivity trait</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBA_VT0004209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBA_VT0004209">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The quality of a sensory perception of sweet taste.</obo:IAO_0000115>
        <rdfs:label>sweet taste sensitivity trait</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBA_VT0004210 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBA_VT0004210">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The quality of a sensory perception of bitter taste.</obo:IAO_0000115>
        <rdfs:label>bitter taste sensitivity trait</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBA_VT0004211 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBA_VT0004211">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The quality of a sensory perception of sour taste.</obo:IAO_0000115>
        <rdfs:label>sour taste sensitivity trait</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBA_VT0004212 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBA_VT0004212">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The quality of a sensory perception of salty taste.</obo:IAO_0000115>
        <rdfs:label>salty taste sensitivity trait</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBA_VT0004213 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBA_VT0004213">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The quality of a sensory perception of umami taste.</obo:IAO_0000115>
        <rdfs:label>umami taste sensitivity trait</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000070 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000070">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A planned process that has the objective to produce information about a material entity (the evaluant) by examining it.</obo:IAO_0000115>
        <rdfs:label>assay</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001000">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A document with a set of printed or written questions with a choice of answers, devised for the purposes of a survey or statistical study.</obo:IAO_0000115>
        <rdfs:label>questionnaire</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000001">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A dependent entity that inheres in a bearer by virtue of how the bearer is related to other entities</obo:IAO_0000115>
        <rdfs:label>quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0000049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000049">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A quality inhering in a bearer by virtue of the bearer&apos;s possessing or displaying a distinctive feature in type or degree or effect or force.</obo:IAO_0000115>
        <rdfs:label>intensity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001241 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001241">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>Relational qualities are qualities that hold between multiple entities. Normal (monadic) qualities such as the shape of a eyeball exist purely as a quality of that eyeball. A relational quality such as sensitivity to light is a quality of that eyeball (and connecting nervous system) as it relates to incoming light waves/particles.</obo:IAO_0000115>
        <rdfs:label>physical object quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001309 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001309">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A process quality inhering in a bearer by virtue of the bearer&apos;s magnitude of the temporal extent between the starting and ending point.</obo:IAO_0000115>
        <rdfs:label>duration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002325 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002325">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>The temporal relation between the start of the process with respect to a reference process.</obo:IAO_0000115>
        <rdfs:label>onset quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002474 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002474">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A flavor quality inhering in a bearer by virtue of the bearer&apos;s having an acrid, sharp, or disagreeable flavor.</obo:IAO_0000115>
        <rdfs:label>bitter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0000167 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000167">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>Anatomical cavity at the start of the digestive tract that that is enclosed by the mouth. The boundaries and contents vary depending on the species. In vertebrates, the boundaries are the oral opening, the cheeks, the palate and (if present) the palatoglossal arch - if this is not present then the mouth and pharynx form the oropharyngeal cavity. The buccal cavity contains the teeth, tongue and palate (when present).</obo:IAO_0000115>
        <rdfs:label>oral cavity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001723 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001723">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A muscular organ in the floor of the mouth.</obo:IAO_0000115>
        <rdfs:label>tongue</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001727 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001727">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>A specialized receptor organ that is a collection of cells spanning the gustatory epithelium.</obo:IAO_0000115>
        <rdfs:label>taste bud</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0002448 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002448">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>Any of the mushroom-shaped papillae, which have a single taste bud at the tip, located mostly on the dorsal anterior portion of the tongue.</obo:IAO_0000115>
        <rdfs:label>fungiform papilla</rdfs:label>
    </owl:Class>
</rdf:RDF>



