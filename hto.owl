    <!-- http://purl.obolibrary.org/obo/HTO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HTO_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000070"/>
        <obo:IAO_0000115>A planned process in which a human taster orally samples a stimulus and reports one or more perceived taste qualities.</obo:IAO_0000115>
        <obo:IAO_0000119>HTO:0000000</obo:IAO_0000119>
        <rdfs:label>tasting event</rdfs:label>
    </owl:Class>
    


