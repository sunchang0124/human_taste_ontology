<http://purl.obolibrary.org/obo/hto.owl> a owl:Ontology ;
  dc:title "Human Taste Ontology" ;
  dc:description "An ontology of human taste perception: the qualities people perceive when they taste, and the tasting events in which they report them." ;
  dc:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:creator "Chang Sun" ;
  rdfs:comment "Developed at BioHackathon 2026, Matsuyama, Japan. The HTO prefix is not yet registered with the OBO Foundry, so HTO PURLs do not resolve." .
