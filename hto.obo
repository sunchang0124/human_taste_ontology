ontology: hto
property_value: dc:description "An ontology of human taste perception: the qualities people perceive when they taste, and the tasting events in which they report them." xsd:string
property_value: dc:license https://creativecommons.org/licenses/by/4.0/
property_value: dc:title "Human Taste Ontology" xsd:string
property_value: dcterms:creator "Chang Sun" xsd:string
