4213> (<http://purl.obolibrary.org/obo/OBA_VT0004213>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/OBA_VT0004213> owl:Thing)\n\n# Class: <http://purl.obolibrary.org/obo/OBI_0000070> (<http://purl.obolibrary.org/obo/OBI_0000070>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/OBI_0000070> owl:Thing)\n\n# Class: <http://purl.obolibrary.org/obo/OBI_0001000> (<http://purl.obolibrary.org/obo/OBI_0001000>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/OBI_0001000> owl:Thing)\n\n# Class: <http://purl.obolibrary.org/obo/PATO_0000001> (<http://purl.obolibrary.org/obo/PATO_0000001>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/PATO_0000001> owl:Thing)\n\n# Class: <http://purl.obolibrary.org/obo/PATO_0000049> (<http://purl.obolibrary.org/obo/PATO_0000049>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/PATO_0000049> owl:Thing)\n\n# Class: <http://purl.obolibrary.org/obo/PATO_0001241> (<http://purl.obolibrary.org/obo/PATO_0001241>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/PATO_0001241> owl:Thing)\n\n# Class: <http://purl.obolibrary.org/obo/PATO_0001309> (<http://purl.obolibrary.org/obo/PATO_0001309>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/PATO_0001309> owl:Thing)\n\n# Class: <http://purl.obolibrary.org/obo/PATO_0002325> (<http://purl.obolibrary.org/obo/PATO_0002325>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/PATO_0002325> owl:Thing)\n\n# Class: <http://purl.obolibrary.org/obo/PATO_0002474> (<http://purl.obolibrary.org/obo/PATO_0002474>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/PATO_0002474> owl:Thing)\n\n# Class: <http://purl.obolibrary.org/obo/UBERON_0000167> (<http://purl.obolibrary.org/obo/UBERON_0000167>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/UBERON_0000167> owl:Thing)\n\n# Class: <http://purl.obolibrary.org/obo/UBERON_0001723> (<http://purl.obolibrary.org/obo/UBERON_0001723>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/UBERON_0001723> owl:Thing)\n\n# Class: <http://purl.obolibrary.org/obo/UBERON_0001727> (<http://purl.obolibrary.org/obo/UBERON_0001727>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/UBERON_0001727> owl:Thing)\n\n# Class: <http://purl.obolibrary.org/obo/UBERON_0002448> (<http://purl.obolibrary.org/obo/UBERON_0002448>)\n\nSubClassOf(<http://purl.obolibrary.org/obo/UBERON_0002448> owl:Thing)\n\n\n############################\n#   Named Individuals\n############################\n\n# Individual: <http://purl.obolibrary.org/obo/HTO_0000224> (<http://purl.obolibrary.org/obo/HTO_0000224>)\n\nObjectPropertyAssertion(<http://purl.obolibrary.org/obo/HTO_0000097> <http://purl.obolibrary.org/obo/HTO_0000224> <http://purl.obolibrary.org/obo/HTO_0000015>)\n\n# Individual: <http://purl.obolibrary.org/obo/HTO_0000225> (<http://purl.obolibrary.org/obo/HTO_0000225>)\n\nObjectPropertyAssertion(<http://purl.obolibrary.org/obo/HTO_0000097> <http://purl.obolibrary.org/obo/HTO_0000225> <http://purl.obolibrary.org/obo/HTO_0000015>)\n\n# Individual: <http://purl.obolibrary.org/obo/HTO_0000226> (<http://purl.obolibrary.org/obo/HTO_0000226>)\n\nObjectPropertyAssertion(<http://purl.obolibrary.org/obo/HTO_0000097> <http://purl.obolibrary.org/obo/HTO_0000226> <http://purl.obolibrary.org/obo/HTO_0000015>)\n\n# Individual: <http://purl.obolibrary.org/obo/HTO_0000227> (<http://purl.obolibrary.org/obo/HTO_0000227>)\n\nObjectPropertyAssertion(<http://purl.obolibrary.org/obo/HTO_0000096> <http://purl.obolibrary.org/obo/HTO_0000227> <http://purl.obolibrary.org/obo/HTO_0000012>)\n\n# Individual: <http://purl.obolibrary.org/obo/HTO_0000228> (<http://purl.obolibrary.org/obo/HTO_0000228>)\n\nObjectPropertyAssertion(<http://purl.obolibrary.org/obo/HTO_0000096> <http://purl.obolibrary.org/obo/HTO_0000228> <http://purl.obolibrary.org/obo/HTO_0000013>)\n\n# Individual: <http://purl.obolibrary.org/obo/HTO_0000229> (<http://purl.obolibrary.org/obo/HTO_0000229>)\n\nObjectPropertyAssertion(<http://purl.obolibrary.org/obo/HTO_0000096> <http://purl.obolibrary.org/obo/HTO_0000229> <http://purl.obolibrary.org/obo/HTO_0000014>)\n\n\n)

[Term]
id: CHEBI:15854
name: quinine
def: "A cinchona alkaloid that is cinchonidine in which the hydrogen at the 6-position of the quinoline ring is substituted by methoxy." []

[Term]
id: CHEBI:16015
name: L-glutamic acid
def: "An optically active form of glutamic acid having <small>L</small>-configuration." []

[Term]
id: CHEBI:16226
name: limonin

[Term]
id: CHEBI:17992
name: sucrose
def: "A glycosyl glycoside formed by glucose and fructose units joined by an acetal oxygen bridge from hemiacetal of glucose to the hemiketal of the fructose." []

[Term]
id: CHEBI:24431
name: chemical entity
def: "A chemical entity is a physical entity of interest in chemistry including molecular entities, parts thereof, and chemical substances." []

[Term]
id: CHEBI:26710
name: sodium chloride
def: "An inorganic chloride salt having sodium(1+) as the counterion." []

[Term]
id: CHEBI:27732
name: caffeine
def: "A trimethylxanthine in which the three methyl groups are located at positions 1, 3, and 7. A purine alkaloid that occurs naturally in tea and coffee." []

[Term]
id: CHEBI:28775
name: hesperidin
def: "A disaccharide derivative that consists of hesperetin substituted by a 6-<em>O</em>-(α-<small>L</small>-rhamnopyranosyl)-β-<small>D</small>-glucopyranosyl moiety at position 7 via a glycosidic linkage." []

[Term]
id: CHEBI:28819
name: naringin
def: "A disaccharide derivative that is (<i>S</i>)-naringenin substituted by a 2-<em>O</em>-(α-<small>L</small>-rhamnopyranosyl)-β-<small>D</small>-glucopyranosyl moiety at position 7 via a glycosidic linkage." []

[Term]
id: CHEBI:30769
name: citric acid
def: "A tricarboxylic acid that is propane-1,2,3-tricarboxylic acid bearing a hydroxy substituent at position 2. It is an important metabolite in the pathway of all aerobic organisms." []

[Term]
id: CHEBI:46261
name: N-phenylthiourea
def: "A member of the class of thioureas that is thiourea in which one of the hydrogens is replaced by a phenyl group. Depending on their genetic makeup, humans find it either very bitter-tasting or tasteless. This unusual property resulted in <em>N</em>-phenylthiourea being used in paternity testing prior to the advent of DNA testing." []

[Term]
id: CHEBI:8502
name: 6-propyl-2-thiouracil
def: "A pyrimidinethione consisting of uracil in which the 2-oxo group is substituted by a thio group and the hydrogen at position 6 is substituted by a propyl group." []

[Term]
id: CL:0000209
name: taste receptor cell
def: "A specialized cell involved in gustatory sensory perception." []

[Term]
id: FOODON:00003027
name: pomelo fruit
def: "A whole fruit of a pomelo tree (Citrus maximus)" []

[Term]
id: FOODON:00003324
name: citrus fruit
def: "A hesperidium fruit of a citrus plant (Citrus)." []

[Term]
id: FOODON:00003554
name: grapefruit
def: "A hesperidium fruit of a grapefruit tree (Citrus x paradisi)." []

[Term]
id: FOODON:00003555
name: mandarin orange
def: "A hesperidium fruit of a mandarin orange tree (Citrus reticulata)." []

[Term]
id: FOODON:00003732
name: yuzu
def: "A hesperidium fruit of a yuzu plant (Citrus junos)" []

[Term]
id: FOODON:03301103
name: orange juice
def: "SIREN DB annotation: * liquid, low viscosity, with small particles FOODON:03430114 * fruit, peel removed, core, pit or seed removed FOODON:03420229" []

[Term]
id: FOODON:03305428
name: lemon juice
def: "SIREN DB annotation: * liquid, low viscosity FOODON:03430109 * fruit, peel present, core, pit or seed present FOODON:03420140" []

[Term]
id: FOODON:03305742
name: citrus juice
def: "SIREN DB annotation: * liquid, low viscosity FOODON:03430109 * fruit, peel present, core, pit or seed present FOODON:03420140" []

[Term]
id: GO:0001580
name: detection of chemical stimulus involved in sensory perception of bitter taste
def: "The series of events required for a bitter taste stimulus to be received and converted to a molecular signal." []

[Term]
id: GO:0008150
name: biological_process
def: "Note that, in addition to forming the root of the biological process ontology, this term is recommended for the annotation of gene products whose biological process is unknown. When this term is used for annotation, it indicates that no information was available about the biological process of the gene product annotated as of the date the annotation was made; the evidence code 'no data' (ND), is used to indicate this." []

[Term]
id: GO:0008527
name: taste receptor activity
def: "Combining with soluble compounds to initiate a change in cell activity. These receptors are responsible for the sense of taste." []

[Term]
id: GO:0033038
name: bitter taste receptor activity
def: "Combining with soluble bitter compounds to initiate a change in cell activity. These receptors are responsible for the sense of bitter taste." []

[Term]
id: GO:0050909
name: sensory perception of taste
def: "The series of events required for an organism to receive a gustatory stimulus, convert it to a molecular signal, and recognize and characterize the signal. Gustation involves the direct detection of chemical composition, usually through contact with chemoreceptor cells. This is a neurological process." []

[Term]
id: GO:0050913
name: sensory perception of bitter taste
def: "The series of events required to receive a bitter taste stimulus, convert it to a molecular signal, and recognize and characterize the signal. This is a neurological process." []

[Term]
id: GO:0050914
name: sensory perception of salty taste
def: "The series of events required to receive a salty taste stimulus, convert it to a molecular signal, and recognize and characterize the signal. This is a neurological process." []

[Term]
id: GO:0050915
name: sensory perception of sour taste
def: "The series of events required to receive a sour taste stimulus, convert it to a molecular signal, and recognize and characterize the signal. This is a neurological process." []

[Term]
id: GO:0050916
name: sensory perception of sweet taste
def: "The series of events required to receive a sweet taste stimulus, convert it to a molecular signal, and recognize and characterize the signal. This is a neurological process." []

[Term]
id: GO:0050917
name: sensory perception of umami taste
def: "The series of events required to receive an umami taste stimulus, convert it to a molecular signal, and recognize and characterize the signal. Umami taste is the savory taste of meats and other foods that are rich in glutamates. This is a neurological process." []

[Term]
id: GO:0090682
name: GPCR bitter taste receptor activity
def: "A G protein-coupled receptor activity that is responsible for the sense of bitter taste." []

[Term]
id: HP:0000223
name: Abnormality of taste sensation

[Term]
id: HP:0000224
name: Hypogeusia
def: "A decreased ability to perceive flavor." []

[Term]
id: HP:0031249
name: Parageusia
def: "A distortion of the sense of taste, often characterized by the sensation of a metallic taste." []

[Term]
id: HP:0041051
name: Ageusia
def: "A rare condition that is characterized by a complete loss of taste function of the tongue." []

[Term]
id: HTO:0000001
name: tasting event
def: "A planned process in which a human taster orally samples a stimulus and reports one or more perceived taste qualities." []
is_a: OBI:0000070 ! assay
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000002
name: taster role
def: "A role borne by a person in virtue of taking part in a tasting event as the person doing the tasting." []
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000003
name: taste stimulus
def: "A material entity presented to a taster to be tasted." []
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000004
name: reference tastant
def: "A taste stimulus consisting of a single chemical compound presented at a stated concentration in order to calibrate or classify a taster." []
is_a: HTO:0000003 ! taste stimulus
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000005
name: taste percept assertion
def: "An information content entity recording that one taster perceived one perceptual taste quality in one stimulus on one occasion." []
is_a: IAO:0000030 ! information content entity
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000006
name: intensity rating
def: "A scalar measurement datum recording how strong a perceived taste quality was, on a stated scale." []
is_a: HTO:0000026 ! rating
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000007
name: hedonic rating
def: "A scalar measurement datum recording how much a taster liked or disliked a stimulus, on a stated scale." []
is_a: HTO:0000026 ! rating
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000008
name: rating scale
def: "An information content entity specifying the permitted values and anchors used to record a rating." []
is_a: IAO:0000030 ! information content entity
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000009
name: detection threshold datum
def: "A scalar measurement datum recording the lowest concentration of a tastant at which a taster reliably detects that something differs from the blank." []
is_a: IAO:0000032 ! scalar measurement datum
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000010
name: recognition threshold datum
def: "A scalar measurement datum recording the lowest concentration of a tastant at which a taster reliably names the quality correctly." []
is_a: IAO:0000032 ! scalar measurement datum
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000011
name: taster status
def: "An organism trait classifying a person by their sensitivity to a reference bitter tastant, conventionally propylthiouracil." []
is_a: OBA:VT0001986 ! taste sensitivity trait
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000012
name: PROP non-taster
def: "A taster status in which the person reports no bitterness from a propylthiouracil test strip." []
is_a: HTO:0000011 ! taster status
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000013
name: PROP medium taster
def: "A taster status in which the person reports moderate bitterness from a propylthiouracil test strip." []
is_a: HTO:0000011 ! taster status
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000014
name: PROP super-taster
def: "A taster status in which the person reports intense bitterness from a propylthiouracil test strip." []
is_a: HTO:0000011 ! taster status
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000015
name: TAS2R38 diplotype
def: "An information content entity recording the pair of TAS2R38 haplotypes carried by a person, each haplotype being the combination of the amino acid states at positions 49, 262 and 296." []
is_a: IAO:0000030 ! information content entity
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000016
name: taste genotype assertion
def: "An information content entity recording an assertion about a person's genotype at a locus relevant to taste perception." []
is_a: IAO:0000030 ! information content entity
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000017
name: tasting session
def: "A planned process comprising the tasting events performed by one or more tasters on one occasion under one protocol." []
is_a: OBI:0000070 ! assay
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000018
name: palate cleansing process
def: "A process performed between tasting events in order to reduce carry-over of taste from the previous stimulus." []
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000019
name: blinding condition
def: "An information content entity stating what the taster was able to know about the identity of the stimulus at the time of tasting." []
is_a: IAO:0000030 ! information content entity
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000020
name: time-intensity profile datum
def: "A scalar measurement datum recording perceived intensity as a function of time since the stimulus entered the mouth." []
is_a: IAO:0000032 ! scalar measurement datum
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000021
name: taste confounder
def: "An information content entity recording a property of a taster that is known to alter taste perception and that should be accounted for when analysing their ratings." []
is_a: IAO:0000030 ! information content entity
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000022
name: tobacco use confounder
def: "A taste confounder recording that the taster currently uses tobacco." []
is_a: HTO:0000021 ! taste confounder
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000023
name: recent upper respiratory infection confounder
def: "A taste confounder recording that the taster recently had an upper respiratory infection, including a recent loss of smell." []
is_a: HTO:0000021 ! taste confounder
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000024
name: xerostomia confounder
def: "A taste confounder recording that the taster has reduced salivary flow." []
is_a: HTO:0000021 ! taste confounder
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000025
name: dysgeusia-associated medication confounder
def: "A taste confounder recording that the taster takes a medication with a documented taste-distortion side effect." []
is_a: HTO:0000021 ! taste confounder
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000026
name: rating
def: "A scalar measurement datum recording a value a taster reported on a stated scale, whether of a perceived quality's intensity or of liking." []
is_a: IAO:0000032 ! scalar measurement datum
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000100
name: perceptual taste quality
def: "A quality of a material entity that is realised when a human perceiver tastes that entity." []
is_a: PATO:0001241 ! physical object quality
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000110
name: basic taste quality
def: "A perceptual taste quality for which a dedicated class of human taste receptor and a dedicated transduction pathway are established." []
is_a: HTO:0000100 ! perceptual taste quality
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000111
name: sweetness
def: "The basic taste quality typically elicited by sucrose and other sugars, transduced by the TAS1R2 and TAS1R3 receptor pair." []
comment: PATO has no term for this quality as of 2026-09-17; proposed to PATO.
is_a: HTO:0000110 ! basic taste quality
relationship: HTO:0000061 GO:0050916 ! perceived via sensory perception of sweet taste
relationship: HTO:0000085 CHEBI:17992 ! elicited by tastant sucrose
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000112
name: sourness
def: "The basic taste quality typically elicited by citric acid and other acids, transduced by proton-sensitive channels of taste receptor cells." []
comment: PATO has no term for this quality as of 2026-09-17; proposed to PATO.
is_a: HTO:0000110 ! basic taste quality
relationship: HTO:0000061 GO:0050915 ! perceived via sensory perception of sour taste
relationship: HTO:0000085 CHEBI:30769 ! elicited by tastant citric acid
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000113
name: saltiness
def: "The basic taste quality typically elicited by sodium chloride. The epithelial sodium channel is implicated in its transduction, and is well supported in rodents, but a substantial part of human salt taste is amiloride-insensitive and the channel's role in humans remains contested." []
comment: PATO has no term for this quality as of 2026-09-17; proposed to PATO.
is_a: HTO:0000110 ! basic taste quality
relationship: HTO:0000061 GO:0050914 ! perceived via sensory perception of salty taste
relationship: HTO:0000085 CHEBI:26710 ! elicited by tastant sodium chloride
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000114
name: bitterness
def: "The basic taste quality typically elicited by quinine and by many plant alkaloids and glycosides, transduced by the TAS2R receptor family." []
comment: Mapped to PATO:0002474 by skos:exactMatch in mappings/hto-pato.sssom.tsv.
is_a: HTO:0000110 ! basic taste quality
relationship: HTO:0000061 GO:0050913 ! perceived via sensory perception of bitter taste
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000115
name: umami
def: "The basic taste quality typically elicited by L-glutamate and by certain ribonucleotides, transduced by the TAS1R1 and TAS1R3 receptor pair." []
comment: PATO has no term for this quality as of 2026-09-17; proposed to PATO.
is_a: HTO:0000110 ! basic taste quality
relationship: HTO:0000061 GO:0050917 ! perceived via sensory perception of umami taste
relationship: HTO:0000085 CHEBI:16015 ! elicited by tastant L-glutamic acid
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000120
name: candidate taste quality
def: "A perceptual taste quality that has been proposed as basic but for which receptor or transduction evidence remains contested." []
comment: Grouped separately so that including these terms does not commit a user of HTO to the claim that they are basic tastes.
is_a: HTO:0000100 ! perceptual taste quality
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000121
name: fattiness
def: "The candidate taste quality elicited by non-esterified fatty acids, proposed under the name oleogustus and distinct from the texture of fat." []
is_a: HTO:0000120 ! candidate taste quality
property_value: IAO:0000119 "PMID:26142421" xsd:string

[Term]
id: HTO:0000122
name: kokumi
def: "The candidate taste quality described as mouthfulness, continuity and thickness, elicited by certain gamma-glutamyl peptides acting on the calcium-sensing receptor." []
is_a: HTO:0000120 ! candidate taste quality
property_value: IAO:0000119 "PMID:39890873" xsd:string

[Term]
id: HTO:0000123
name: metallic taste
def: "The candidate taste quality elicited by certain metal salts and reported as a side effect of some medications." []
is_a: HTO:0000120 ! candidate taste quality
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000124
name: calcium taste
def: "The candidate taste quality elicited by calcium salts, reported as chalky and somewhat bitter." []
is_a: HTO:0000120 ! candidate taste quality
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000125
name: starchy taste
def: "The candidate taste quality elicited by oligomeric glucose polymers independently of sweetness." []
is_a: HTO:0000120 ! candidate taste quality
property_value: IAO:0000119 "PMID:27553043" xsd:string

[Term]
id: HTO:0000130
name: bitterness subtype
def: "A bitterness distinguished by the chemical class of the compound that elicits it and, where known, by the receptor that detects it." []
is_a: HTO:0000114 ! bitterness
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000131
name: thiourea bitterness
def: "The bitterness elicited by compounds bearing a thiourea group, notably phenylthiocarbamide and propylthiouracil, detected by TAS2R38." []
comment: The quality whose perception varies most sharply between people.
is_a: HTO:0000130 ! bitterness subtype
relationship: HTO:0000085 CHEBI:46261 ! elicited by tastant N-phenylthiourea
relationship: HTO:0000085 CHEBI:8502 ! elicited by tastant 6-propyl-2-thiouracil
property_value: IAO:0000119 "PMID:12595690" xsd:string

[Term]
id: HTO:0000132
name: limonoid bitterness
def: "The bitterness elicited by limonoid triterpenoids, notably limonin, which forms from a tasteless precursor after citrus fruit is juiced." []
is_a: HTO:0000130 ! bitterness subtype
relationship: HTO:0000085 CHEBI:16226 ! elicited by tastant limonin
property_value: IAO:0000119 "PMID:25615579" xsd:string

[Term]
id: HTO:0000133
name: flavanone bitterness
def: "The bitterness elicited by flavanone glycosides, notably naringin, characteristic of grapefruit and pomelo." []
is_a: HTO:0000130 ! bitterness subtype
relationship: HTO:0000085 CHEBI:28819 ! elicited by tastant naringin
property_value: IAO:0000119 "PMID:9250119" xsd:string

[Term]
id: HTO:0000134
name: alkaloid bitterness
def: "The bitterness elicited by plant alkaloids such as quinine and caffeine." []
is_a: HTO:0000130 ! bitterness subtype
relationship: HTO:0000085 CHEBI:27732 ! elicited by tastant caffeine
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000135
name: amino acid bitterness
def: "The bitterness elicited by hydrophobic amino acids and by peptides rich in them, prominent in protein hydrolysates and aged cheese." []
is_a: HTO:0000130 ! bitterness subtype
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000140
name: chemesthetic quality
def: "A quality perceived in the mouth through the trigeminal nerve rather than through taste receptor cells, recorded alongside taste by sensory panels." []
comment: Not a taste sensu stricto. Included because panels record it and because astringency is central to citrus assessment.
is_a: HTO:0000100 ! perceptual taste quality
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000141
name: astringency
def: "The chemesthetic quality of drying, roughening and puckering in the mouth, elicited by tannins and other polyphenols binding salivary proteins." []
comment: CHEBI:74783 astringent exists but denotes a chemical role, not a perceptual quality.
is_a: HTO:0000140 ! chemesthetic quality
property_value: IAO:0000119 "PMID:27640622" xsd:string

[Term]
id: HTO:0000142
name: pungency
def: "The chemesthetic quality of burning or stinging, elicited by capsaicinoids, piperine and allyl isothiocyanate." []
is_a: HTO:0000140 ! chemesthetic quality
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000143
name: cooling sensation
def: "The chemesthetic quality of coolness in the absence of a temperature change, elicited by menthol and related compounds." []
is_a: HTO:0000140 ! chemesthetic quality
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000144
name: tingling sensation
def: "The chemesthetic quality of vibration or numbness, elicited by alkylamides such as sanshool." []
is_a: HTO:0000140 ! chemesthetic quality
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000145
name: carbonation bite
def: "The chemesthetic quality elicited by dissolved carbon dioxide, arising from two distinct routes: conversion of carbon dioxide by carbonic anhydrase 4 on sour-sensing taste cells, and a separate trigeminal contribution." []
is_a: HTO:0000140 ! chemesthetic quality
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000150
name: temporal taste quality
def: "A perceptual taste quality defined by when it appears or how long it persists relative to the stimulus entering the mouth." []
is_a: HTO:0000100 ! perceptual taste quality
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000151
name: taste onset latency
def: "The temporal taste quality of how long after the stimulus enters the mouth a taste is first perceived." []
is_a: HTO:0000150 ! temporal taste quality
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000152
name: aftertaste
def: "The temporal taste quality of a taste that persists after the stimulus has been swallowed or expectorated." []
is_a: HTO:0000150 ! temporal taste quality
property_value: IAO:0000119 "SNOMEDCT:110365009" xsd:string

[Term]
id: HTO:0000153
name: lingering bitterness
def: "An aftertaste that is bitter in quality." []
comment: Prefer the post-coordinated form for new data: a taste profile entry with entry quality bitterness and entry phase finish. This term is retained for continuity and is accepted by scripts/profile2rdf.py, which normalises it to that form.
is_a: HTO:0000152 ! aftertaste
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000154
name: delayed bitterness
def: "A bitterness that is absent or weak when the stimulus is first tasted and appears or strengthens over subsequent minutes to hours." []
comment: Characteristic of citrus juice, where limonin forms after juicing. Prefer the post-coordinated form for new data: a taste profile entry with entry quality bitterness and entry phase finish. This term is retained for continuity — the published walkthrough cites it — and is accepted by scripts/profile2rdf.py, which normalises it to that form.
is_a: HTO:0000152 ! aftertaste
property_value: IAO:0000119 "PMID:25615579" xsd:string

[Term]
id: HTO:0000155
name: taste adaptation
def: "The temporal taste quality of a perceived intensity declining during continued exposure to an unchanging stimulus." []
is_a: HTO:0000150 ! temporal taste quality
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000160
name: hedonic taste quality
def: "A quality of a stimulus consisting in how much a perceiver likes or dislikes tasting it, as distinct from what they perceive." []
is_a: HTO:0000100 ! perceptual taste quality
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000161
name: palatability
def: "The hedonic taste quality of being pleasant to taste for a given perceiver." []
is_a: HTO:0000160 ! hedonic taste quality
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000162
name: taste aversion
def: "The hedonic taste quality of being unpleasant to taste for a given perceiver, whether innately or through learning." []
is_a: HTO:0000160 ! hedonic taste quality
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000200
name: taste intensity level
def: "An ordinal degree at which a perceptual taste quality is reported to be present in a kind of food or drink." []
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000210
name: tasting phase
def: "A stage of a single tasting, from the first contact of the sample with the tongue to the sensation remaining after swallowing." []
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000220
name: taster group
def: "A group of human tasters sharing a characteristic relevant to how they perceive taste." []
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000222
name: genotype-defined taster group
def: "A taster group whose membership is defined by a genotype at a taste receptor locus." []
is_a: HTO:0000220 ! taster group
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000223
name: phenotype-defined taster group
def: "A taster group whose membership is defined by a measured taste phenotype rather than by genotype." []
is_a: HTO:0000220 ! taster group
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000230
name: taste interaction effect
def: "The direction in which one perceptual taste quality alters the perceived intensity of another." []
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000240
name: evidence type
def: "The kind of evidence on which a taste profile entry's claim rests." []
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000300
name: general Labelled Magnitude Scale
def: "A rating scale running from zero to one hundred with quasi-logarithmically spaced verbal anchors from barely detectable to strongest imaginable sensation of any kind, permitting comparison of intensities across people." []
is_a: HTO:0000008 ! rating scale
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000301
name: Labelled Magnitude Scale
def: "A rating scale running from zero to one hundred with verbal anchors referring to the strongest imaginable taste sensation rather than to any sensation." []
is_a: HTO:0000008 ! rating scale
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000302
name: nine-point hedonic scale
def: "A rating scale with nine categories running from dislike extremely to like extremely, used to record liking." []
is_a: HTO:0000008 ! rating scale
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000303
name: visual analogue scale
def: "A rating scale on which the taster marks a point on an unstructured line of stated length, conventionally one hundred millimetres." []
is_a: HTO:0000008 ! rating scale
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000304
name: just-about-right scale
def: "A rating scale with categories running from far too little to far too much about a stated attribute, centred on just about right." []
is_a: HTO:0000008 ! rating scale
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000305
name: PROP filter paper strip protocol
def: "An assay in which a taster places a filter paper impregnated with propylthiouracil on the tongue and reports the bitterness, used to assign taster status." []
is_a: OBI:0000070 ! assay
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000400
name: taste profile entry
def: "One line of the taste profile of a kind of food or drink: a single quality, at a single ordinal level, at a single phase of the tasting, holding for a single group of tasters, from a single source." []
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: HTO:0000410
name: taste interaction
def: "An asserted relation in which the presence of one perceptual taste quality alters the perceived intensity of another, as established by a cited study using named chemical stimuli." []
property_value: IAO:0000119 "HTO:0000000" xsd:string

[Term]
id: IAO:0000030
name: information content entity
def: "A generically dependent continuant that is about some thing." []

[Term]
id: IAO:0000032
name: scalar measurement datum
def: "A scalar measurement datum is a measurement datum that is composed of two parts, numerals and a unit label." []

[Term]
id: IAO:0000109
name: measurement datum
def: "A measurement datum is an information content entity that is a recording of the output of a measurement such as produced by a device." []

[Term]
id: OBA:VT0001986
name: taste sensitivity trait
def: "The sensitivity toward of a sensory perception of taste." []

[Term]
id: OBA:VT0004209
name: sweet taste sensitivity trait
def: "The quality of a sensory perception of sweet taste." []

[Term]
id: OBA:VT0004210
name: bitter taste sensitivity trait
def: "The quality of a sensory perception of bitter taste." []

[Term]
id: OBA:VT0004211
name: sour taste sensitivity trait
def: "The quality of a sensory perception of sour taste." []

[Term]
id: OBA:VT0004212
name: salty taste sensitivity trait
def: "The quality of a sensory perception of salty taste." []

[Term]
id: OBA:VT0004213
name: umami taste sensitivity trait
def: "The quality of a sensory perception of umami taste." []

[Term]
id: OBI:0000070
name: assay
def: "A planned process that has the objective to produce information about a material entity (the evaluant) by examining it." []

[Term]
id: OBI:0001000
name: questionnaire
def: "A document with a set of printed or written questions with a choice of answers, devised for the purposes of a survey or statistical study." []

[Term]
id: PATO:0000001
name: quality
def: "A dependent entity that inheres in a bearer by virtue of how the bearer is related to other entities" []

[Term]
id: PATO:0000049
name: intensity
def: "A quality inhering in a bearer by virtue of the bearer's possessing or displaying a distinctive feature in type or degree or effect or force." []

[Term]
id: PATO:0001241
name: physical object quality
def: "Relational qualities are qualities that hold between multiple entities. Normal (monadic) qualities such as the shape of a eyeball exist purely as a quality of that eyeball. A relational quality such as sensitivity to light is a quality of that eyeball (and connecting nervous system) as it relates to incoming light waves/particles." []

[Term]
id: PATO:0001309
name: duration
def: "A process quality inhering in a bearer by virtue of the bearer's magnitude of the temporal extent between the starting and ending point." []

[Term]
id: PATO:0002325
name: onset quality
def: "The temporal relation between the start of the process with respect to a reference process." []

[Term]
id: PATO:0002474
name: bitter
def: "A flavor quality inhering in a bearer by virtue of the bearer's having an acrid, sharp, or disagreeable flavor." []

[Term]
id: UBERON:0000167
name: oral cavity
def: "Anatomical cavity at the start of the digestive tract that that is enclosed by the mouth. The boundaries and contents vary depending on the species. In vertebrates, the boundaries are the oral opening, the cheeks, the palate and (if present) the palatoglossal arch - if this is not present then the mouth and pharynx form the oropharyngeal cavity. The buccal cavity contains the teeth, tongue and palate (when present)." []

[Term]
id: UBERON:0001723
name: tongue
def: "A muscular organ in the floor of the mouth." []

[Term]
id: UBERON:0001727
name: taste bud
def: "A specialized receptor organ that is a collection of cells spanning the gustatory epithelium." []

[Term]
id: UBERON:0002448
name: fungiform papilla
def: "Any of the mushroom-shaped papillae, which have a single taste bud at the tip, located mostly on the dorsal anterior portion of the tongue." []

[Typedef]
id: HTO:0000050
name: has taster
def: "Relates a tasting event to the person who performed the tasting." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000001 ! tasting event

[Typedef]
id: HTO:0000051
name: has stimulus
def: "Relates a tasting event to the material that was tasted." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000001 ! tasting event
range: HTO:0000003 ! taste stimulus

[Typedef]
id: HTO:0000052
name: asserts quality
def: "Relates a taste percept assertion to the perceptual taste quality it reports." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000005 ! taste percept assertion
range: HTO:0000100 ! perceptual taste quality

[Typedef]
id: HTO:0000053
name: has intensity rating
def: "Relates a taste percept assertion to the intensity value reported for it." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000005 ! taste percept assertion
range: HTO:0000006 ! intensity rating

[Typedef]
id: HTO:0000054
name: on scale
def: "Relates a rating to the scale on which it was recorded." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000026 ! rating
range: HTO:0000008 ! rating scale

[Typedef]
id: HTO:0000055
name: has hedonic rating
def: "Relates a tasting event to the liking score the taster gave the sample." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000001 ! tasting event
range: HTO:0000007 ! hedonic rating

[Typedef]
id: HTO:0000056
name: part of session
def: "Relates a tasting event to the session in which it took place." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000001 ! tasting event
range: HTO:0000017 ! tasting session

[Typedef]
id: HTO:0000057
name: has taster status
def: "Relates a person to their assessed taster status." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
range: HTO:0000011 ! taster status

[Typedef]
id: HTO:0000058
name: has genotype assertion
def: "Relates a person to a recorded assertion about their taste-related genotype." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
range: HTO:0000016 ! taste genotype assertion

[Typedef]
id: HTO:0000059
name: stimulus derived from
def: "Relates a taste stimulus to the food or beverage class it was prepared from." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000003 ! taste stimulus

[Typedef]
id: HTO:0000060
name: stimulus contains tastant
def: "Relates a taste stimulus to a chemical entity present in it that bears a taste quality." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000003 ! taste stimulus

[Typedef]
id: HTO:0000061
name: perceived via
def: "Relates a perceptual taste quality to the biological process by which it is perceived." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000100 ! perceptual taste quality
range: GO:0008150 ! biological_process

[Typedef]
id: HTO:0000062
name: detected by receptor
def: "Relates a perceptual taste quality to a receptor whose activation is established to contribute to perceiving it." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000100 ! perceptual taste quality

[Typedef]
id: HTO:0000063
name: has output assertion
def: "Relates a tasting event to a taste percept assertion produced in it." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000001 ! tasting event
range: HTO:0000005 ! taste percept assertion

[Typedef]
id: HTO:0000064
name: typically associated with diplotype
def: "Relates a taster status to a diplotype that commonly but not invariably produces it. This is a statistical association and deliberately not an equivalence." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000011 ! taster status
range: HTO:0000015 ! TAS2R38 diplotype

[Typedef]
id: HTO:0000065
name: has diplotype
def: "Relates a person or a study group to the diplotype they carry, or that characterises them." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
range: HTO:0000015 ! TAS2R38 diplotype

[Typedef]
id: HTO:0000066
name: threshold for quality
def: "Relates a threshold datum to the perceptual taste quality whose detection or recognition it measures." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000009 ! detection threshold datum
range: HTO:0000100 ! perceptual taste quality

[Typedef]
id: HTO:0000080
name: has profile entry
def: "Relates a kind of food or drink to one line of its taste profile." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
range: HTO:0000400 ! taste profile entry

[Typedef]
id: HTO:0000081
name: entry quality
def: "Relates a taste profile entry to the perceptual taste quality it reports." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000400 ! taste profile entry
range: HTO:0000100 ! perceptual taste quality

[Typedef]
id: HTO:0000082
name: entry level
def: "Relates a taste profile entry to the ordinal intensity level at which the quality is reported." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000400 ! taste profile entry
range: HTO:0000200 ! taste intensity level

[Typedef]
id: HTO:0000083
name: entry phase
def: "Relates a taste profile entry to the phase of the tasting at which the quality is reported." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000400 ! taste profile entry
range: HTO:0000210 ! tasting phase

[Typedef]
id: HTO:0000084
name: holds for group
def: "Relates a taste profile entry to the group of tasters for whom it is asserted to hold." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000400 ! taste profile entry
range: HTO:0000220 ! taster group

[Typedef]
id: HTO:0000085
name: elicited by tastant
def: "Relates a perceptual taste quality to a chemical entity whose presence elicits it." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000100 ! perceptual taste quality
range: CHEBI:24431 ! chemical entity

[Typedef]
id: HTO:0000086
name: contains tastant
def: "Relates a kind of food or drink to a chemical entity it contains that is capable of eliciting a taste quality." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
range: CHEBI:24431 ! chemical entity

[Typedef]
id: HTO:0000087
name: interaction agent
def: "Relates a taste interaction to the quality whose presence produces the effect." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000410 ! taste interaction
range: HTO:0000100 ! perceptual taste quality

[Typedef]
id: HTO:0000088
name: interaction target
def: "Relates a taste interaction to the quality whose perceived intensity is altered." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000410 ! taste interaction
range: HTO:0000100 ! perceptual taste quality

[Typedef]
id: HTO:0000089
name: interaction effect
def: "Relates a taste interaction to the direction of the effect the agent has on the target." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000410 ! taste interaction
range: HTO:0000230 ! taste interaction effect

[Typedef]
id: HTO:0000090
name: demonstrated with
def: "Relates a taste interaction to a chemical entity used as a stimulus in the study that established it." []
property_value: IAO:0000119 "HTO:0000000" xsd:string
domain: HTO:0000410 ! taste interaction
range: CHEBI:24431 ! chemical entity

[Typedef]
